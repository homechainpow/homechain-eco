{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "miner_pribadi",
  "version": "2.0.2",
  "identifier": "com.homechain.miner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "HomeChain Auto-Miner (miner_pribadi)",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "HomeChain Network",
    "shortDescription": "HomeChain Node Desktop Miner",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
